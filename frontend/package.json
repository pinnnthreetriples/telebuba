{
  "name": "telebuba-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "boundaries": "steiger ./src",
    "test": "vitest run --coverage",
    "ds:doc": "node scripts/design-system-doc.mjs",
    "ds:doc:check": "node scripts/design-system-doc.mjs --check",
    "gates": "npm run boundaries && npm run lint && npm run format && npm run typecheck && npm run ds:doc:check && npm run test",
    "gen:api": "openapi-ts && prettier --write \"src/shared/api/**/*.{ts,tsx}\""
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.0"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@sentry/react": "^8.45.1",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.87.0",
    "@tanstack/react-table": "^8.20.6",
    "clsx": "^2.1.1",
    "flag-icons": "^7.3.2",
    "i18next": "^24.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.2.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "steiger": "^0.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
