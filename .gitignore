# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local config
.env
.env.local

# Telethon sessions (credentials)
*.session
*.session-journal

# Upload staging (credentials) — API__UPLOAD_STAGING_DIR defaults inside the
# working tree, and a staged telebuba_upload_* file IS the tdata/session archive.
# The name pattern covers a staging dir relocated elsewhere in the tree.
runtime/
telebuba_upload_*

# SQLite databases (runtime data)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs
debug.log
*.log

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Frontend (React SPA) — deps + build/coverage output; the generated client is committed.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.cov-tmp/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
mutants/
mutation-report/

# AI agent caches / per-machine config
.serena/
# ...except aislop's config, which is project policy (gate scope + telemetry off),
# not a per-machine cache: untracked, the CI gate silently scanned frontend/ too.
.aislop/*
!.aislop/config.yml
.agents/
.codex/
.friday/
.specify/

# Per-machine Claude Code skill bundles (installed by the skills manager)
.claude/skills/
skills-lock.json
# Per-machine dev-server launch config (created by the preview/run tooling)
.claude/launch.json

.tmp_backups/
