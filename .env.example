# Telebuba environment template.
# Copy to `.env` and fill in secrets. Every key mirrors a field in core/config.py
# (nested pydantic-settings, one namespace per domain). Values shown are the
# in-code defaults; the test suite asserts this file stays in sync with config.
# Keys use the double-underscore convention: NAMESPACE__FIELD.

# --- Telegram (TELEGRAM__) -------------------------------------------------
TELEGRAM__API_ID=0
TELEGRAM__API_HASH=
TELEGRAM__SESSION_DIR=sessions
TELEGRAM__TIMEOUT_SECONDS=20
TELEGRAM__CONNECTION_RETRIES=3
TELEGRAM__RETRY_DELAY_SECONDS=2
TELEGRAM__REQUEST_RETRIES=3
# 0 disables Telethon's built-in auto-sleep; we handle FloodWait explicitly.
TELEGRAM__FLOOD_SLEEP_THRESHOLD=0
# Phone-login: how long a requested SMS code's hash stays usable (seconds).
TELEGRAM__PHONE_CODE_TTL_SECONDS=300

# --- API (API__) -----------------------------------------------------------
# 127.0.0.1 binds loopback only; set 0.0.0.0 for a container/prod deploy.
API__HOST=127.0.0.1
API__PORT=8080
# JSON list of allowed CORS origins for the SPA (dev uses the Vite proxy, so empty).
API__CORS_ORIGINS=[]
# Send Access-Control-Allow-Credentials. When true, CORS_ORIGINS must not be ["*"].
API__CORS_ALLOW_CREDENTIALS=true
# Reverse-proxy trust: when true, uvicorn rewrites the client IP from X-Forwarded-For
# for connections from FORWARDED_ALLOW_IPS (comma-separated, or "*"). Off by default.
API__TRUST_PROXY_HEADERS=false
API__FORWARDED_ALLOW_IPS=127.0.0.1
API__VERSION=v1
# SSE live-event stream tunables (GET /api/v1/events).
API__SSE_KEEPALIVE_SECONDS=15
API__SSE_MAX_QUEUE=1000
# Hard request-body ceiling, counted as bytes arrive (chunked encoding included) and
# enforced before auth. Must stay above PROFILE_MEDIA__TDATA_MAX_BYTES + framing.
API__MAX_REQUEST_BYTES=210000000
# The fallback ceiling for every route and for upload requests without a valid,
# non-revoked session. Only exact multipart upload routes may receive the large cap.
API__MAX_ANONYMOUS_REQUEST_BYTES=1000000
# Simultaneous authenticated uploads admitted from body read through cleanup.
API__MAX_CONCURRENT_UPLOADS=2
# Staging for streamed .session/tdata credential uploads. Made owner-only (0700) and
# verified as such on POSIX only — on Windows there is no such mode, so the files are
# protected by the parent directory and by their bounded lifetime, nothing else.
API__UPLOAD_STAGING_DIR=runtime/uploads
# Startup removes abandoned staging files older than this many seconds.
API__UPLOAD_STAGING_TTL_SECONDS=86400

# --- Auth (AUTH__) ---------------------------------------------------------
# JWT signing secret — set a long random value before enabling login.
AUTH__SECRET=
AUTH__ALGORITHM=HS256
AUTH__COOKIE_NAME=tb_session
# Set false only for local http dev (the cookie is HttpOnly + SameSite regardless).
AUTH__COOKIE_SECURE=true
AUTH__COOKIE_SAMESITE=strict
AUTH__SESSION_TTL_MINUTES=720
# First-admin seeding (no public signup): an admin is created at startup when no
# users exist and both are set.
AUTH__ADMIN_USERNAME=
AUTH__ADMIN_PASSWORD=
AUTH__LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH__LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Concurrent Argon2 hashes/verifications (each worker is deliberately memory-heavy).
AUTH__ARGON2_MAX_CONCURRENCY=2

# --- Database (DB__) -------------------------------------------------------
DB__PATH=telebuba.db
# Connection pool sizing (every DB call runs under asyncio.to_thread).
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__POOL_TIMEOUT_SECONDS=30
# Periodic maintenance: WAL checkpoint always runs; backup (VACUUM INTO) is opt-in.
DB__BACKUP_ENABLED=false
DB__BACKUP_INTERVAL_HOURS=24
DB__BACKUP_DIR=backups
DB__BACKUP_KEEP=7

# --- Proxy pool (PROXY__) --------------------------------------------------
# How many accounts may share one pool proxy ("до N аккаунтов на прокси").
PROXY__MAX_ACCOUNTS_PER_PROXY=3
# HTTPS endpoint called through the proxy to discover its real exit IP.
PROXY__EXIT_IP_HOST=api64.ipify.org
PROXY__EXIT_IP_PATH=/?format=json
PROXY__EXIT_IP_PORT=443
PROXY__CHECK_TIMEOUT_SECONDS=8
# Free IPinfo Lite token: https://ipinfo.io/signup
PROXY__IPINFO_TOKEN=
PROXY__IPINFO_BASE_URL=https://api.ipinfo.io/lite
# Optional free MaxMind GeoLite Country cross-check (1,000 requests/day).
PROXY__MAXMIND_ACCOUNT_ID=
PROXY__MAXMIND_LICENSE_KEY=
PROXY__MAXMIND_BASE_URL=https://geolite.info/geoip/v2.1/country
PROXY__DATACENTER_ASN_KEYWORDS=["amazon","aws","google","microsoft","azure","digitalocean","hetzner","ovh","linode","vultr","contabo","leaseweb","m247","choopa","oracle","scaleway"]

# --- Profile media limits (PROFILE_MEDIA__) --------------------------------
PROFILE_MEDIA__PHOTO_MAX_BYTES=10000000
PROFILE_MEDIA__STORY_IMAGE_MAX_BYTES=10000000
PROFILE_MEDIA__STORY_VIDEO_MAX_BYTES=100000000
# Multi-photo collage story: max photos per composite + inter-cell gap (px).
PROFILE_MEDIA__STORY_COLLAGE_MAX_IMAGES=6
PROFILE_MEDIA__STORY_COLLAGE_GAP_PX=8
PROFILE_MEDIA__MUSIC_MAX_BYTES=30000000
# Concurrent thumbnail downloads per read batch (photo history / stories).
PROFILE_MEDIA__THUMB_CONCURRENCY=4
PROFILE_MEDIA__SESSION_MAX_BYTES=5000000
PROFILE_MEDIA__TDATA_MAX_BYTES=200000000
# In-process TTL for the live-profile snapshot the edit-profile dialog uses.
PROFILE_MEDIA__READ_SNAPSHOT_TTL_SECONDS=30
PROFILE_MEDIA__MUSIC_PREVIEW_LIMIT=50
# History-scan depth when re-resolving a photo's fresh InputPhoto for «make main».
PROFILE_MEDIA__SET_MAIN_HISTORY_LIMIT=100
# Hard cap (seconds) on each ffmpeg subprocess in the story-video normaliser.
PROFILE_MEDIA__FFMPEG_TIMEOUT_SECONDS=120
# Browser cache lifetime (seconds) for the per-item profile thumbnail endpoints.
PROFILE_MEDIA__THUMB_CACHE_MAX_AGE_SECONDS=3600

# --- Channel management (CHANNELS__) ----------------------------------------
CHANNELS__AVATAR_MAX_BYTES=10000000
CHANNELS__POST_PHOTO_MAX_BYTES=10000000
CHANNELS__POST_VIDEO_MAX_BYTES=100000000
# Default page size for the channel-posts list endpoint.
CHANNELS__POSTS_PAGE_LIMIT=20
# Max own channels returned by the list endpoint.
CHANNELS__LIST_LIMIT=100
# How many dialogs to scan when discovering the account's own channels.
CHANNELS__DIALOGS_SCAN_LIMIT=500

# --- Logging (LOGGING__) ---------------------------------------------------
LOGGING__PATH=debug.log
LOGGING__LEVEL=INFO
LOGGING__ROTATION=10 MB
LOGGING__RETENTION=10
LOGGING__SENTRY_DSN=

# --- Warming engine (WARMING__) --------------------------------------------
# Per-action pacing.
WARMING__ACTION_DELAY_MIN_SECONDS=10
WARMING__ACTION_DELAY_MAX_SECONDS=30
WARMING__TYPING_MIN_SECONDS=5
WARMING__TYPING_MAX_SECONDS=30
WARMING__READING_MIN_SECONDS=8
WARMING__READING_MAX_SECONDS=45
# Fallback cool-down when a FloodWait carries no duration.
WARMING__FLOOD_WAIT_FALLBACK_HOURS=24
# Human margin on a timed FloodWait: wait *= 1 + uniform(0, this).
WARMING__FLOOD_WAIT_MARGIN_FRACTION=0.1
WARMING__STARTUP_JITTER_MAX_SECONDS=8
# Cold-start spread (hours) for a fresh account's first run: a hard ceiling on the
# wait before the FIRST cycle, and it wins over the active-hours window. The snap
# to the account's next local morning only fits under the ceiling when this exceeds
# the quiet window (24 - active window) plus the morning spread; at 5 vs a 9h quiet
# window it never fits, so ~37% of cold starts begin in the account's local night.
# Raise to ~13 for daytime-only first cycles at the cost of a longer wait.
WARMING__COLD_START_SPREAD_HOURS=5
# Catch-up spread (seconds): past-due accounts resumed after downtime fan out
# across this window instead of all firing at delay 0.
WARMING__CATCH_UP_SPREAD_SECONDS=1800
# Fleet-wide ceiling on Telegram-heavy warming cycles running at once.
WARMING__CYCLE_CONCURRENCY=8
WARMING__CHANNELS_PER_CYCLE_MIN=1
WARMING__CHANNELS_PER_CYCLE_MAX=3
# Fraction of the pool forming each account's stable channel interest set — de-correlates the fleet.
WARMING__CHANNEL_AFFINITY_RATIO=0.25
# Slow affinity churn: re-score the interest subset every N days; strength keeps
# the drift gradual (0=frozen, 1=reshuffled each epoch).
WARMING__CHANNEL_AFFINITY_CHURN_DAYS=14
WARMING__CHANNEL_AFFINITY_CHURN_STRENGTH=0.2
# Per-cycle chance to sample one channel from outside the affinity set.
WARMING__CHANNEL_EXPLORATION_PROBABILITY=0.1
WARMING__REACTION_PROBABILITY=0.6
WARMING__REACTION_MESSAGE_LIMIT=20
WARMING__DEFAULT_REACTIONS=["👍","🔥","❤","😁","🎉","👏","🤔","🙏"]
# Fallback pool excludes these when a restrictive channel allows none of ours.
WARMING__REACTION_NEGATIVE_EMOJI=["👎","💩","🤮","🤬","😡","🖕","🤢"]
# Channel guardrails.
WARMING__MAX_CHANNELS_TOTAL=500
WARMING__MAX_CHANNELS_PER_ADD=50
WARMING__MAX_CHANNEL_LENGTH=120
WARMING__CHAT_MESSAGE_MAX_CHARS=300
WARMING__CHAT_MESSAGE_MAX_LINES=4
WARMING__STOP_CANCEL_TIMEOUT_SECONDS=5
WARMING__ENFORCE_READINESS=true
# Watch subscribed channels' stories once per session (applies to every persona).
WARMING__STORY_VIEW_ENABLED=true
# ± jitter fraction on the persona-derived inter-session gap.
WARMING__NEXT_RUN_JITTER_FRACTION=0.25
# 0 = no per-account daily action cap.
WARMING__MAX_DAILY_ACTIONS=0
# No outbound DM until the account is this many hours old (counted from import,
# not from the real Telegram account age). Short by design so inter-account
# dialogue starts on day one; raise it if DM restrictions start appearing.
WARMING__DM_MIN_AGE_HOURS=5
WARMING__SPAM_STATUS_TTL_HOURS=36
# Quarantine recovery.
WARMING__QUARANTINE_HOURS=48
WARMING__QUARANTINE_MAX_REPEATS=3
# Content de-duplication / filtering.
WARMING__CONTENT_DEDUP_WINDOW_DAYS=7
WARMING__CONTENT_MAX_ATTEMPTS=3
WARMING__CONTENT_BLOCK_LINKS=true
WARMING__CONTENT_FORBIDDEN_WORDS=["реклама","купить","продам","продаю","скидк","промокод"]
# Retention windows for append-only tables (0 disables that purge).
WARMING__LOG_RETENTION_DAYS=30
WARMING__DIALOGUE_MESSAGE_RETENTION_DAYS=90
WARMING__SENT_HASH_RETENTION_DAYS=14
WARMING__PURGE_INTERVAL_HOURS=24
# Inter-account dialogue pairing.
WARMING__DIALOGUE_PARTNERS_MIN=2
WARMING__DIALOGUE_PARTNERS_MAX=4
WARMING__DIALOGUE_RESHUFFLE_DAYS=10
WARMING__DIALOGUE_MAX_TURNS=12
WARMING__DIALOGUE_CONVERSATION_WINDOW_HOURS=48
# Recent pair messages fed to the LLM as conversation context (0 = off).
WARMING__DIALOGUE_CONTEXT_MESSAGES=6
# Reject a generated line this Jaccard-similar to a recent one in the pair.
WARMING__DIALOGUE_SIMILARITY_MAX=0.8
# "Saw it, replying" pause before answering an incoming DM.
WARMING__DM_READ_REPLY_DELAY_MIN_SECONDS=2
WARMING__DM_READ_REPLY_DELAY_MAX_SECONDS=15
# Human-like timing: clipped log-normal inter-action pauses.
WARMING__DELAY_LOGNORM_MU=-0.8
WARMING__DELAY_LOGNORM_SIGMA=0.6
# Typing simulation.
WARMING__TYPING_SIMULATION_ENABLED=true
WARMING__TYPING_WPM=45
# Per-account typing tempo range (stable hash picks each account's WPM).
WARMING__TYPING_WPM_MIN=32
WARMING__TYPING_WPM_MAX=58
WARMING__TYPING_SIM_MIN_SECONDS=0.5
WARMING__TYPING_SIM_MAX_SECONDS=12
# Active local-time window (account phone timezone).
WARMING__ACTIVE_HOURS_ENABLED=true
WARMING__ACTIVE_HOURS_START=8
WARMING__ACTIVE_HOURS_END=23
# Morning band (minutes) a snapped resume lands in — each account has a stable
# hashed "chronotype" offset inside it, so the fleet histogram is a hump, not a
# rectangle. Clamped to the active-window width.
WARMING__ACTIVE_HOURS_START_SPREAD_MINUTES=240
# Soft daily wobble (± minutes) around the stable chronotype offset.
WARMING__CHRONOTYPE_JITTER_MINUTES=25
# Per-deployment salt for the fleet-de-correlation hashes (chronotype, affinity,
# quiet-day). Empty = unsalted.
WARMING__FLEET_HASH_SALT=
# Quiet days: chance an account rests a whole calendar day (decided once/day,
# weekend-biased). 0 disables.
WARMING__QUIET_DAY_WEEKDAY_PROBABILITY=0.05
WARMING__QUIET_DAY_WEEKEND_PROBABILITY=0.15
# Per-card activity-log panel: how many recent log rows to show (newest-first).
WARMING__CARD_LOG_LIMIT=30
# Lifecycle-phase + activity-persona safety tables (JSON values). Effective
# behaviour is always min(persona, phase/trust).
# Age (hours) assumed for an account with a missing/unparseable created_at.
WARMING__UNKNOWN_AGE_FALLBACK_HOURS=192
# Fresh accounts younger than this (hours) can't exceed the intro phase.
WARMING__PHASE_HARD_FLOOR_AGE_HOURS=24
# Rough action count of one session; caps sessions/day by the phase budget.
WARMING__EXPECTED_ACTIONS_PER_SESSION=5
# Upper day bound of each phase (inclusive); null = terminal (no next bound).
WARMING__PHASE_DAY_BOUND={"intro":1,"settling":7,"warming":14,"active":29,"warmed":null}
# Daily action cap by phase (80 = CRMChat ceiling for accounts >=2-3 months).
# Also sets the cadence: cap // EXPECTED_ACTIONS_PER_SESSION = sessions per day,
# and the active window is split between them. Below 2x the divisor you get one
# session and a ~15h gap; at or below the divisor the story glance and the
# inter-account DM never get budget. "intro" at 15 = 3 sessions, ~5h gap.
# The cap must never drop as an account ages, so "settling" follows "intro" up.
WARMING__PHASE_DAILY_CAP={"intro":15,"settling":15,"warming":20,"active":40,"warmed":80}
# Activity-persona presets: sessions/day range + per-session reaction/DM probability.
WARMING__PERSONA_SESSIONS={"calm":[4,8],"normal":[10,16],"active":[20,28]}
WARMING__PERSONA_REACTION_PROBABILITY={"calm":0.15,"normal":0.4,"active":0.7}
WARMING__PERSONA_DM_PROBABILITY={"calm":0.1,"normal":0.3,"active":0.55}

# --- Gemini (GEMINI__) -----------------------------------------------------
GEMINI__API_KEY=
GEMINI__MODEL=gemini-2.5-flash
GEMINI__BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI__TIMEOUT_SECONDS=30
GEMINI__TEMPERATURE=0.9
# Reply budget for the short-text callers (comments, warming chat), which run with
# thinking off. Sits above the worst case (30 words of Cyrillic/Arabic tokenizes
# heavily) because hitting the cap is now a failed generation, not a truncated reply.
GEMINI__MAX_OUTPUT_TOKENS=256
# Retry a transient 429/5xx/transport failure this many times before erroring.
GEMINI__MAX_RETRIES=1
# Backoff slept between retries (seconds).
GEMINI__RETRY_BACKOFF_SECONDS=1
# Minimum spacing between Gemini calls (seconds); 0 = no throttle. Seeds the
# operator-editable settings-row default and the gateway fallback.
GEMINI__MIN_INTERVAL_SECONDS=0

# --- OpenAI (OPENAI__) — alternative captcha-solver LLM (ChatGPT) ----------
# Fallback for the OpenAI captcha key; the operator normally sets it in the UI
# (stored in the DB). GPT vision handles image captchas well.
OPENAI__API_KEY=
OPENAI__MODEL=gpt-4o
OPENAI__BASE_URL=https://api.openai.com/v1
OPENAI__TIMEOUT_SECONDS=30
OPENAI__TEMPERATURE=0.0
OPENAI__MAX_OUTPUT_TOKENS=300
OPENAI__MAX_RETRIES=1
OPENAI__RETRY_BACKOFF_SECONDS=1

# --- DeepSeek (DEEPSEEK__) — the TEXT generator -----------------------------
# Writes neurocomment comments and warming chat lines. Serves the OpenAI wire
# format, so it rides `core.openai` rather than a gateway of its own.
# EMPTY KEY = OFF: text generation falls back to Gemini, unchanged. That is the
# only switch — there is no provider setting to flip.
# Unlike the Gemini/OpenAI keys this one is NOT operator-set in the UI: it is
# deployment config, so it lives here and nowhere else.
DEEPSEEK__API_KEY=
# deepseek-v4-flash is TEXT-ONLY (DeepSeek publishes input_modalities: ["text"]).
# Anything carrying an image — a caption-less photo post, an image captcha —
# stays on Gemini no matter what this key says. Do not point this at a model you
# expect to read pictures.
DEEPSEEK__MODEL=deepseek-v4-flash
DEEPSEEK__BASE_URL=https://api.deepseek.com
# Higher than the other providers': this one writes comments, and a post whose
# rounds all time out is a post nobody comments on.
DEEPSEEK__TIMEOUT_SECONDS=60
DEEPSEEK__TEMPERATURE=0.9
# Budget for the REPLY. V4 reasons by default and bills the thoughts to the same
# ceiling, so the gateway explicitly disables thinking for generation — otherwise
# reasoning eats this whole number and every comment comes back truncated. Raising
# it does not re-enable reasoning; only a caller asking for it does.
DEEPSEEK__MAX_OUTPUT_TOKENS=256
DEEPSEEK__MAX_RETRIES=1
DEEPSEEK__RETRY_BACKOFF_SECONDS=1

# --- Trust score (TRUST__) -------------------------------------------------
# Band lower bounds (score >= bound -> that band).
TRUST__EXCELLENT_MIN=90
TRUST__GOOD_MIN=75
TRUST__WATCH_MIN=60
TRUST__AT_RISK_MIN=40
# Penalties subtracted from a 100 baseline.
TRUST__PENALTY_NOT_ALIVE=40
TRUST__PENALTY_SPAM_LIMITED=50
TRUST__PENALTY_SPAM_UNKNOWN=0
TRUST__PENALTY_QUARANTINE_EACH=15
TRUST__PENALTY_FLOOD_ACTIVE=15
TRUST__PENALTY_GEO_MISMATCH=10
TRUST__PENALTY_GEO_UNKNOWN=5
TRUST__PENALTY_PROXY_FAILED=20
TRUST__PENALTY_NEW_ACCOUNT=10
TRUST__NEW_ACCOUNT_HOURS=48

# --- Neurocomment engine (NEUROCOMMENT__) ----------------------------------
# Whether the fleet comments first or waits for a human to comment and answers one
# of them. These are the shipped DEFAULTS for a fresh install; the operator's own
# choice lives in the DB (neurocomment_settings) and the board's mode toggle writes
# it there, so changing them here does not move a running deployment.
NEUROCOMMENT__COMMENT_MODE=first
# How long a parked post waits for human comments before we comment first anyway.
# Resolved by the deletion sweep, so `reply` mode is inert while that sweep is off.
NEUROCOMMENT__REPLY_WAIT_MINUTES=10
# Human-like pause before replying to a fresh post.
NEUROCOMMENT__REPLY_DELAY_MIN_SECONDS=3
NEUROCOMMENT__REPLY_DELAY_MAX_SECONDS=10
# Spacing between discussion-group joins at campaign onboarding.
NEUROCOMMENT__JOIN_DELAY_MIN_SECONDS=30
NEUROCOMMENT__JOIN_DELAY_MAX_SECONDS=120
# Per-account rolling-24h channel-join cap (0 = no cap).
NEUROCOMMENT__MAX_JOINS_PER_ACCOUNT_PER_DAY=20
# Approval-gated groups: hours between the two join requests, and how many are sent.
# Their product is also the patience budget — after it the channel leaves the campaign.
NEUROCOMMENT__JOIN_REQUEST_RETRY_HOURS=24
NEUROCOMMENT__JOIN_REQUEST_MAX_ATTEMPTS=2
# How many LOSSES of one watch channel the LISTENER absorbs, within the window below,
# before leaving it alone — the original join is already spent, so 2 buys exactly ONE
# re-join and 1 buys none. A channel whose peer stops resolving refills the
# lost-access report on every reconcile, and the per-account join cap cannot bound it
# (one join per pass). Only losses inside the window count (168 hours = 7 days), so the
# give-up self-heals and two unrelated blips months apart no longer silence a channel.
NEUROCOMMENT__LISTENER_REJOIN_MAX_ATTEMPTS=2
NEUROCOMMENT__LISTENER_REJOIN_ATTEMPT_WINDOW_HOURS=168
# Per-account throughput ceiling.
NEUROCOMMENT__MAX_COMMENTS_PER_HOUR=10
# Cap on recent posted comments carried in the board's published-comments feed.
NEUROCOMMENT__BOARD_COMMENT_FEED_LIMIT=50
# Minimum Trust Score to be picked for commenting (0 = no gate).
NEUROCOMMENT__MIN_TRUST_SCORE=0
# Comment length guardrail (words).
NEUROCOMMENT__COMMENT_MAX_WORDS=30
# Per-(account, channel) daily comment cap (0 = no cap).
NEUROCOMMENT__MAX_COMMENTS_PER_CHANNEL_PER_DAY=3
# Retries for a failed comment attempt before giving up.
NEUROCOMMENT__MAX_RETRIES=2
# Cross-account semantic dedup (token-set Jaccard): reject a candidate whose max
# similarity to a recent posted comment in the same channel/window reaches this
# threshold, then regenerate. Lower it to catch looser paraphrases at the cost of
# extra regenerations; raise it to only catch near-verbatim repeats. 0 disables the
# guard entirely (only the exact-hash claim remains, so two accounts can post
# near-identical comments in one channel).
NEUROCOMMENT__SEMANTIC_DEDUP_THRESHOLD=0.8
# Look-back window (hours) for the semantic-dedup comparison set.
NEUROCOMMENT__SEMANTIC_DEDUP_WINDOW_HOURS=24
# In-memory cooldown after a PEER_FLOOD before the account is reselected.
NEUROCOMMENT__PEER_FLOOD_COOLDOWN_SECONDS=3600
# Link-stripped word-char budget below which a post is treated as link-only/ad.
NEUROCOMMENT__LINK_ONLY_MAX_WORD_CHARS=10
# Byte ceiling on a caption-less post's photo before it is shown to the model
# (vision). A bigger original rides along as its biggest size that fits, so this
# is really a resolution/memory knob: one in-flight post costs ~5x this, and up
# to max_concurrent_post_tasks of them are in flight (1 MB => ~250 MB fleet-wide).
# 0 turns the vision path off entirely and caption-less photo posts go back to
# being skipped.
NEUROCOMMENT__VISION_MAX_IMAGE_BYTES=1000000
# Grace period to await in-flight on-post tasks on shutdown before cancelling.
NEUROCOMMENT__STOP_CANCEL_TIMEOUT_SECONDS=5
# L4: max concurrently in-flight on-post handler tasks (excess posts dropped under flood).
NEUROCOMMENT__MAX_CONCURRENT_POST_TASKS=50
# Bounded fresh-post recovery after boot/reconnect. This is explicit history paging,
# never Telethon catch_up: only the newest N posts, only within TTL, paced per channel.
NEUROCOMMENT__POST_BACKFILL_TTL_SECONDS=900
NEUROCOMMENT__POST_BACKFILL_LIMIT_PER_CHANNEL=10
NEUROCOMMENT__POST_BACKFILL_MAX_PAGES_PER_CHANNEL=5
NEUROCOMMENT__POST_BACKFILL_CHANNEL_DELAY_SECONDS=0.5
NEUROCOMMENT__POST_BACKFILL_MAX_CHANNELS=50
NEUROCOMMENT__POST_BACKFILL_RETRY_SECONDS=30
NEUROCOMMENT__POST_BACKFILL_INTERVAL_SECONDS=300
NEUROCOMMENT__POST_INBOX_MAX_PENDING=5000
NEUROCOMMENT__POST_INBOX_MAX_ATTEMPTS=5
NEUROCOMMENT__POST_INBOX_RETRY_BASE_SECONDS=5
NEUROCOMMENT__POST_INBOX_RETRY_MAX_SECONDS=300
# L3: startup reclaim — claims stuck 'claimed' older than this are released to 'failed'.
NEUROCOMMENT__STALE_CLAIM_RECLAIM_SECONDS=900
# --- Ф2: deletion sweep -> escalating channel back-off ---
# How often the sweep re-reads recent comments (0 disables the sweep).
NEUROCOMMENT__DELETION_SWEEP_INTERVAL_SECONDS=300
# How far back the sweep re-checks posted comments for deletion.
NEUROCOMMENT__DELETION_SWEEP_LOOKBACK_HOURS=24
# Retention for the append-only neurocomment tables (comments/challenges/join log).
# 0 = keep forever. Solved challenges are always kept (they are the decision cache).
# Any non-zero value below 1 is floored to one day: the join log backs a rolling-24h
# per-account cap, and purging inside that window would let an account exceed it.
NEUROCOMMENT__RETENTION_DAYS=90
# How often the prune runs (it rides the deletion sweep, but at most this often).
NEUROCOMMENT__RETENTION_PRUNE_INTERVAL_HOURS=24
# A channel that has published nothing for this many days leaves its campaign, and its
# comment authors walk out of its discussion group. 0 disables the rule; anything else is
# at least 1 day. Never decided on our own silence alone — the listener sees posts only
# while the app is up — so only a dated post older than the window retires a channel; a
# failed or empty read decides nothing, and a channel that proves alive is kept and
# reported.
NEUROCOMMENT__INACTIVE_CHANNEL_DROP_DAYS=7
# Max concurrent Telegram ban probes for the "check channels" button.
NEUROCOMMENT__BAN_CHECK_CONCURRENCY=4
# Ф2 challenge solver — global default ON (per-campaign solver_enabled overrides).
NEUROCOMMENT__CHALLENGE_SOLVER_ENABLED=true
# Window the onboarding solver waits for a guardian-bot challenge after joining.
NEUROCOMMENT__CHALLENGE_WAIT_TIMEOUT_SECONDS=20
# Hard cutoff on the Gemini decision call (text challenges).
NEUROCOMMENT__CHALLENGE_GEMINI_TIMEOUT_SECONDS=10
# Hard cutoff on the VISION decision call (image captcha upload) — must stay above the
# provider gateway's own 30s budget, else we truncate a request it is still answering.
NEUROCOMMENT__CHALLENGE_VISION_TIMEOUT_SECONDS=45
# Hard cutoff on dispatching the answer (button click / text send) so a hung call can't stall onboarding.
NEUROCOMMENT__CHALLENGE_DISPATCH_TIMEOUT_SECONDS=15
# Log-normal humanization pause before answering, clamped to [min, max] (~human 8-40s).
NEUROCOMMENT__CHALLENGE_CLICK_DELAY_MIN_SECONDS=8
NEUROCOMMENT__CHALLENGE_CLICK_DELAY_MAX_SECONDS=40
# Default captcha-solver LLM (operator overrides in the UI): gemini | openai.
NEUROCOMMENT__CAPTCHA_LLM_PROVIDER=gemini
# Attempts before giving up on a captcha (a wrong click can get the account kicked).
NEUROCOMMENT__CHALLENGE_MAX_ATTEMPTS=2
# Window to watch for a re-challenge after answering (= "was the answer wrong?").
NEUROCOMMENT__CHALLENGE_RECHECK_TIMEOUT_SECONDS=8
# M4: min Gemini confidence for the solver to act on a decision (below → give_up).
NEUROCOMMENT__CHALLENGE_MIN_CONFIDENCE=0.7
# Floor on comment length in words (1 = off). Defence in depth behind the gateway's
# truncation check — a one-word comment is the most bot-looking thing we can post.
NEUROCOMMENT__COMMENT_MIN_WORDS=2
# Reasoning tokens the solver may spend before answering (Gemini path only; 0 = off).
# Unlike a comment, a captcha decision benefits from thinking — the vision prompt asks
# the model to describe the image first — so this path opts in where short text stays 0.
NEUROCOMMENT__CHALLENGE_THINKING_BUDGET=512
# Combined thoughts + decision-JSON budget for the solver. Must exceed the thinking
# budget with room for the JSON, or the answer is cut mid-string and fails validation.
NEUROCOMMENT__CHALLENGE_MAX_OUTPUT_TOKENS=1024
# How long an unsolved captcha stays in the operator's "требуют проверки" queue. The audit
# table keeps failures for the whole retention window, so without this the queue listed
# every captcha ever lost — work nobody can still pick up, next to today's rows.
NEUROCOMMENT__CHALLENGE_QUEUE_MAX_AGE_DAYS=3
# C1: button label substrings/regex the solver must never click (payment/admin/vote/login/wallet).
NEUROCOMMENT__CHALLENGE_BUTTON_DENYLIST_PATTERNS=["pay\\b","payment","оплат","плат","donat","withdraw","deposit","wallet","кошел","bank","card","карт","admin","админ","\\bvote\\b","голос","log ?in","sign ?in","войти","вход","password","пароль","invite","claim","airdrop","bonus","crypto","authoriz","authoris"]
# Ф2 "this channel will not let us write": K consecutive write failures (a captcha the
# solver lost or a write gate) end a round and pause the channel for a flat window;
# after CHANNEL_MAX_ROUNDS pauses it leaves its campaign. Round + deadline are persisted.
NEUROCOMMENT__CHANNEL_CHALLENGE_BACKOFF_MIN_FAILURES=3
NEUROCOMMENT__CHANNEL_PAUSE_HOURS=24
NEUROCOMMENT__CHANNEL_MAX_ROUNDS=2
# Min warming age (days) for an account to show as "warmed" in the neurocomment page.
NEUROCOMMENT__WARMED_MIN_DAYS=14
# Rows in the engine panel's collapsible neurocomment-activity log.
NEUROCOMMENT__LOG_LIMIT=50
# Channel discovery ("Найти каналы"): candidate cap, rolling-24h search ceiling,
# jittered pacing between real RPCs, linked-group cache freshness, and the consecutive
# failures that abort a pass on a dead session (a half-dead one trips a failure-rate
# rule in services, deliberately not a knob).
NEUROCOMMENT__DISCOVERY_MAX_CANDIDATES=100
NEUROCOMMENT__DISCOVERY_MAX_SEARCHES_PER_DAY=20
NEUROCOMMENT__DISCOVERY_QUALIFY_DELAY_MIN_SECONDS=1.0
NEUROCOMMENT__DISCOVERY_QUALIFY_DELAY_MAX_SECONDS=2.0
NEUROCOMMENT__DISCOVERY_LINKED_GROUP_TTL_HOURS=168
NEUROCOMMENT__DISCOVERY_MAX_CONSECUTIVE_ERRORS=3
# One read budget for the whole run, spent across its waves in order: keyword sweep, the
# operator's seed channel, global post pages, then the recommendation wave, whose reads
# are held back so the post pages cannot eat them. A wave the budget cuts short is
# reported as truncated instead of quietly returning less. The shape of each wave is
# deliberately not a knob — this ceiling is the one that matters. The default sits above
# the most a run can want (26, at the maximum ten keywords), so a truncated run means
# this was lowered.
NEUROCOMMENT__DISCOVERY_MAX_READS_PER_RUN=30

# --- Neuroshilling engine (NEUROSHILLING__) --------------------------------
# Several accounts play assigned roles and act out a scripted dialogue in target
# chats. Ceilings on what one campaign may be shaped like.
NEUROSHILLING__MIN_ACCOUNTS=2
NEUROSHILLING__MAX_TARGETS_PER_CAMPAIGN=20
NEUROSHILLING__MAX_TARGET_LENGTH=120
NEUROSHILLING__MAX_ROLES=5
NEUROSHILLING__MAX_STEPS=20
# Join pacing and the rolling-24h per-account join ceiling (0 = no cap). The same
# numbers neurocomment uses: the limit belongs to Telegram, not to a feature.
NEUROSHILLING__JOIN_DELAY_MIN_SECONDS=30
NEUROSHILLING__JOIN_DELAY_MAX_SECONDS=120
NEUROSHILLING__MAX_JOINS_PER_ACCOUNT_PER_DAY=20
# Floor on the gap between two sends by the SAME account, and the clipped
# log-normal shape every human-like pause is drawn from (as in warming).
NEUROSHILLING__SEND_MIN_GAP_SECONDS=30
NEUROSHILLING__DELAY_LOGNORM_MU=-0.8
NEUROSHILLING__DELAY_LOGNORM_SIGMA=0.6
# Generation budget: rolling-24h call ceiling, retries per generation, and the
# output cap (2048 is the hard ceiling of the gateway request schema).
NEUROSHILLING__MAX_LLM_CALLS_PER_DAY=200
NEUROSHILLING__LLM_MAX_ATTEMPTS=3
NEUROSHILLING__LLM_MAX_OUTPUT_TOKENS=2048
# Chat listening: per-MESSAGE character ceiling, how many messages of context,
# and the jittered poll interval.
NEUROSHILLING__MAX_CHAT_CONTEXT_CHARS=500
NEUROSHILLING__CHAT_CONTEXT_MESSAGES=20
NEUROSHILLING__POLL_MIN_SECONDS=30
NEUROSHILLING__POLL_MAX_SECONDS=60
# Probability of answering a given human message, per "reply activity" setting.
NEUROSHILLING__REPLY_CHANCE_CALM=0.1
NEUROSHILLING__REPLY_CHANCE_MEDIUM=0.3
NEUROSHILLING__REPLY_CHANCE_ACTIVE=0.6
